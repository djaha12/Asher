*.bat text eol=crlf
# PowerShell-скрипт живёт на компьютере магазина и открывается в Блокноте —
# ему нужны те же переводы строк, что и .bat. Метка BOM в начале файла при
# этом сохраняется: без неё PowerShell 5.1 читает файл как ANSI и весь
# русский текст превращается в мусор.
*.ps1 text eol=crlf
